#!/usr/bin/env bash
set -euo pipefail

failed=0
while IFS= read -r -d '' file; do
  # Read the staged version, not potentially different unstaged working-tree content.
  if git show ":$file" 2>/dev/null | grep -nE 'TODO|FIXME'; then
    printf 'Commit blocked: TODO/FIXME found in staged file: %s\n' "$file"
    failed=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "$failed" -ne 0 ]; then
  echo "Remove TODO/FIXME from staged files before committing."
  exit 1
fi
exit 0
