#!/usr/bin/env bash
set -euo pipefail

message_file="$1"
message="$(head -n 1 "$message_file")"

if [ "${#message}" -lt 10 ]; then
  echo "Commit blocked: message must be at least 10 characters."
  exit 1
fi

if ! printf '%s\n' "$message" | grep -Eq '^(feat|fix|docs|refactor|chore): .+'; then
  echo "Commit blocked: use feat:, fix:, docs:, refactor: or chore: followed by a description."
  exit 1
fi

exit 0
